# Database Configuration
DATABASE_URL=sqlite:///./data/job_market.db

# Data Sources
LINKEDIN_API_KEY=your_linkedin_api_key_here
KAGGLE_API_KEY=your_kaggle_api_key_here
KAGGLE_DATASET_ID=
KAGGLE_RAW_DATA_DIR=./data/raw

# Kafka
# Leave blank for local workflows that should skip Kafka publishing.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=job_postings
KAFKA_CONSUMER_GROUP_ID=job_posting_consumers

# BigQuery
BIGQUERY_PROJECT=
BIGQUERY_DATASET=bronze
BIGQUERY_TABLE=raw_job_postings

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
MARKET_REGION=Germany
DEFAULT_CURRENCY=EUR
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
INGESTION_API_TOKEN=
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60

# NLP Model
NLP_MODEL=bert-base-uncased

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Local data paths
DEFAULT_SOURCES=["legal_demo_csv"]
DEFAULT_KEYWORDS=["Data Engineer Berlin","Machine Learning Engineer Germany","Cloud Engineer Munich"]
DEFAULT_LIMIT_PER_SOURCE=100
DEFAULT_JOBS_OUTPUT_PATH=./data/jobs.csv
TRAINING_DATA_PATH=./data/job_postings_training.csv
PRODUCTION_DATA_PATH=./data/job_postings_production.csv

# Model configuration
ROLE_PREDICTOR_RANDOM_STATE=42
ROLE_PREDICTOR_MAX_ITER=1000
ROLE_DEMAND_GROWTH_PER_QUARTER=0.08
ROLE_PREDICTION_TOP_N=10
ROLE_PREDICTOR_BASELINE_ACCURACY=0.8
ROLE_PREDICTOR_BASELINE_F1_MACRO=0.8

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_EXPERIMENT_NAME=job-market-role-prediction
MLFLOW_REGISTERED_MODEL_NAME=job_market_role_predictor
